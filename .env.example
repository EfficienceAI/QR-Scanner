# PassKit REST credentials: app.passkit.com > Developer Tools > REST Credentials
PASSKIT_API_KEY=
PASSKIT_API_SECRET=

# Optional. EU is the default region; use https://api.pub2.passkit.io for USA accounts.
# PASSKIT_API_BASE=https://api.pub1.passkit.io

# Optional. Leave empty (bare JWT, PassKit's own sample). Set to "Bearer" only if PassKit returns 401.
# PASSKIT_AUTH_SCHEME=

# Optional. How the QR payload maps to a member: "id" (default, PassKit member id) or "externalId".
# PASSKIT_ID_MODE=id
# PASSKIT_PROGRAM_ID=            # required only when PASSKIT_ID_MODE=externalId

# Optional business rules (defaults match the current scanner UI).
# LOYALTY_REDEEM_COST=9
# LOYALTY_MAX_POINTS_PER_SCAN=99

# Required for the scan counter, the chart and the backfill. Supabase project
# settings > API. The service key bypasses RLS, so it is server-side only:
# never expose it to the page.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required only to run /api/admin/backfill (the one-off PassKit history import).
ADMIN_SECRET=

# Optional. The shop's clock, used to bucket scans by local day and hour.
# SHOP_TIMEZONE=Europe/London

# Optional. Ceiling on one ledger call, in ms (default 4000). Writes happen
# after the response, so this only bounds how long an invocation lingers.
# LEDGER_TIMEOUT_MS=4000
