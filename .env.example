# PassKit REST credentials: app.passkit.com > Developer Tools > REST Credentials
PASSKIT_API_KEY=
PASSKIT_API_SECRET=

# Optional. EU is the default region; use https://api.pub2.passkit.io for USA accounts.
# PASSKIT_API_BASE=https://api.pub1.passkit.io

# Optional. Leave empty (bare JWT, PassKit's own sample). Set to "Bearer" only if PassKit returns 401.
# PASSKIT_AUTH_SCHEME=

# Optional. How the QR payload maps to a member: "id" (default, PassKit member id) or "externalId".
# PASSKIT_ID_MODE=id
# PASSKIT_PROGRAM_ID=            # required only when PASSKIT_ID_MODE=externalId

# Optional business rules (defaults match the current scanner UI).
# LOYALTY_REDEEM_COST=9
# LOYALTY_MAX_POINTS_PER_SCAN=99

# Required for the scan counter, the chart and the backfill. Supabase project
# settings > API. The service key bypasses RLS, so it is server-side only:
# never expose it to the page.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required only to run /api/admin/backfill (the one-off PassKit history import).
ADMIN_SECRET=

# Optional. The shop's clock, used to bucket scans by local day and hour.
# SHOP_TIMEZONE=Europe/London

# Optional. Ceiling on one ledger call, in ms (default 4000). Writes happen
# after the response, so this only bounds how long an invocation lingers.
# LEDGER_TIMEOUT_MS=4000

# ---- Native passes (the PassKit replacement; see docs/NATIVE-PASSES.md) ----
# Apple Developer: Team ID and the Pass Type ID you created.
APPLE_TEAM_ID=
PASS_TYPE_ID=
# Pass Type ID certificate and private key as base64-encoded PEM (export from Keychain, see the doc).
PASS_CERT_PEM_B64=
PASS_KEY_PEM_B64=
# PASS_KEY_PASSPHRASE=
# Public https origin Wallet calls back to for pass updates. Must be reachable without a login.
PUBLIC_BASE_URL=
# Optional wording / colours on the pass.
# PASS_ORG_NAME=La Bottega Milanese
# PASS_DESCRIPTION=La Bottega Milanese loyalty card
# PASS_LOGO_TEXT=La Bottega Milanese
# PASS_BACKGROUND_COLOR=rgb(17, 17, 20)
# PASS_FOREGROUND_COLOR=rgb(255, 255, 255)
# PASS_LABEL_COLOR=rgb(160, 160, 170)
# PASS_SUPPORT_TEXT=Ask a member of staff.
# Artwork set: default | christmas | auto (Christmas from 1 Dec to 2 Jan). Re-push passes after changing it.
# PASS_THEME=default
# Where the nine stamps show: text (circles on the row under the photo, next to the name) or strip (beans drawn on the photo).
# PASS_STAMP_STYLE=text
# Apple's WWDR G4 intermediate is bundled in certs/; override only if Apple rotates it.
# PASS_WWDR_PEM_B64=
# Push notifications to Wallet when a pass changes (uses the same certificate). "false" to disable.
# APNS_ENABLED=true
# APNS_PUSH_TYPE=
# Origins allowed to POST /api/join cross-site (e.g. a Carrd page). Comma-separated. Same-origin needs nothing.
# JOIN_ALLOWED_ORIGINS=
