{
  "name": "la-bottega-loyalty-scanner",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=20"
  },
  "description": "La Bottega Milanese loyalty: scanner (PassKit, legacy) and the native pass system (signup page, members database, signed Apple Wallet passes, pass web service).",
  "scripts": {
    "test": "node --test",
    "dev": "node scripts/dev-server.mjs --mock",
    "dev:live": "node scripts/dev-server.mjs",
    "audit": "node scripts/audit-check.mjs",
    "verify": "node --test && node scripts/dev-server.mjs --mock --selftest && node scripts/audit-check.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "passkit-generator": "^3.6.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "node-forge": "^1.4.0"
  }
}
